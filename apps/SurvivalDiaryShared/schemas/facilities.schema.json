{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://survival-diary.zhengzhengstudio.cn/schemas/facilities-v1.json",
  "title": "Survival Diary facility definitions",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "slots", "capabilities", "interactionRange", "offlineCapMinutes"],
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
      "slots": {
        "type": "object",
        "propertyNames": { "enum": ["storage", "input", "fuel", "output"] },
        "additionalProperties": { "type": "integer", "minimum": 0 }
      },
      "capabilities": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": { "enum": ["open", "transfer", "process", "craft", "sleep", "shelter", "repair", "dismantle"] }
      },
      "interactionRange": { "type": "number", "minimum": 1 },
      "offlineCapMinutes": { "type": "integer", "minimum": 0, "maximum": 1440 }
    }
  }
}
